# Local-server Docker context: deny by default, then public source only.
**
!local_server/
!local_server/*.py
!local_server/web/
!local_server/web/*.html
!local_server/web/*.js
!local_server/web/*.css
!scripts/
!scripts/*.py
!config/
!config/local-server-mapping.json
!docs/
!docs/fish/
!docs/fish/ontology-review/
!docs/fish/ontology-review/**
!infra/
!infra/local-server/
!infra/local-server/Dockerfile
!infra/local-server/Fuseki.Dockerfile
!infra/local-server/Dockerfile.dockerignore
!infra/local-server/Fuseki.Dockerfile.dockerignore
!infra/local-server/requirements.lock
!infra/local-server/versions.lock.json
!infra/local-server/LocalFusekiRunner.java
!infra/local-server/container-config.json
!infra/local-server/fuseki.ttl

# Final exclusions override every allow rule, including accidental files in docs.
**/.*
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.runtime/**
**/runtime/**
**/.tools/**
**/.venv*/**
**/venv/**
**/backups/**
**/backup/**
**/asset-placement-work-*/**
**/uploads/**
**/imports/**
**/releases/**
**/original/**
**/originals/**
**/raw/**
**/*.env
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.token
**/token
**/token.*
**/*credentials*
**/*password*
**/*secret*
**/private*
**/config.json
**/*private*.json
**/deployment.json
**/provision-state.json
**/process.json
**/processes.json
**/postmaster.*
**/*.pid
**/*.lock
**/*.log
**/*.db
**/*.sqlite*
**/*.pgdump
**/*.sql
**/*.zip
**/*.tar*
**/*.nq*
**/*.nt
**/restore-report.json
**/asset-placement*.json

# Public build input only; all other runtime *.lock files remain excluded.
!infra/local-server/requirements.lock
