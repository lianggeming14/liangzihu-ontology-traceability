# Copy to a PRIVATE .runtime/local-server/compose.env. Use different long random
# hexadecimal values; URL-encode non-URL-safe passwords before building DSNs.
LZO_LOCAL_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_HEX
LZO_LOCAL_API_PASSWORD=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_HEX
LZO_LOCAL_WORKER_PASSWORD=REPLACE_WITH_ANOTHER_PRIVATE_RANDOM_HEX
LZO_LOCAL_WRITE_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
