@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:lzo:drawing-ontology:aggregationPolicy> a owl:DatatypeProperty ;
    rdfs:label "累计规则"@zh .

<urn:lzo:drawing-ontology:componentLabel> a owl:DatatypeProperty ;
    rdfs:label "componentLabel"@zh .

<urn:lzo:drawing-ontology:componentsSi> a owl:DatatypeProperty ;
    rdfs:label "componentsSi"@zh .

<urn:lzo:drawing-ontology:containsDrawingAnnotation> a owl:ObjectProperty ;
    rdfs:label "containsDrawingAnnotation"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:containsDrawingAnnotation:inverse> .

<urn:lzo:drawing-ontology:coordinateSystem> a owl:DatatypeProperty ;
    rdfs:label "coordinateSystem"@zh .

<urn:lzo:drawing-ontology:depictedIn> a owl:ObjectProperty ;
    rdfs:label "描绘于图纸"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:depictedIn:inverse> .

<urn:lzo:drawing-ontology:derivedFromStatement> a owl:ObjectProperty ;
    rdfs:label "derivedFromStatement"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:derivedFromStatement:inverse> .

<urn:lzo:drawing-ontology:hasMeasurement> a owl:ObjectProperty ;
    rdfs:label "具有测量记录"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:hasMeasurement:inverse> .

<urn:lzo:drawing-ontology:identityScope> a owl:DatatypeProperty ;
    rdfs:label "identityScope"@zh .

<urn:lzo:drawing-ontology:locatedIn> a owl:ObjectProperty ;
    rdfs:label "所属图示分区"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:locatedIn:inverse> .

<urn:lzo:drawing-ontology:memberOfReportedWorksGroup> a owl:ObjectProperty ;
    rdfs:label "memberOfReportedWorksGroup"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:memberOfReportedWorksGroup:inverse> .

<urn:lzo:drawing-ontology:numericValue> a owl:DatatypeProperty ;
    rdfs:label "原单位数值"@zh .

<urn:lzo:drawing-ontology:objectKind> a owl:DatatypeProperty ;
    rdfs:label "objectKind"@zh .

<urn:lzo:drawing-ontology:partOfProject> a owl:ObjectProperty ;
    rdfs:label "partOfProject"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:partOfProject:inverse> .

<urn:lzo:drawing-ontology:partOfTable> a owl:ObjectProperty ;
    rdfs:label "partOfTable"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:partOfTable:inverse> .

<urn:lzo:drawing-ontology:quantityKind> a owl:DatatypeProperty ;
    rdfs:label "量的类型"@zh .

<urn:lzo:drawing-ontology:repeatsReportedQuantity> a owl:ObjectProperty ;
    rdfs:label "repeatsReportedQuantity"@zh ;
    owl:inverseOf <urn:lzo:drawing-ontology:repeatsReportedQuantity:inverse> .

<urn:lzo:drawing-ontology:representationId> a owl:DatatypeProperty ;
    rdfs:label "representationId"@zh .

<urn:lzo:drawing-ontology:reviewStatus> a owl:DatatypeProperty ;
    rdfs:label "复核状态"@zh .

<urn:lzo:drawing-ontology:siUnit> a owl:DatatypeProperty ;
    rdfs:label "SI 单位"@zh .

<urn:lzo:drawing-ontology:siValue> a owl:DatatypeProperty ;
    rdfs:label "SI 换算值"@zh .

<urn:lzo:drawing-ontology:sourcePath> a owl:DatatypeProperty ;
    rdfs:label "sourcePath"@zh .

<urn:lzo:drawing-ontology:sourceQuantityKind> a owl:DatatypeProperty ;
    rdfs:label "原始类型"@zh .

<urn:lzo:drawing-ontology:sourceRecord> a owl:DatatypeProperty ;
    rdfs:label "来源原始记录"@zh .

<urn:lzo:drawing-ontology:sourceSha256> a owl:DatatypeProperty ;
    rdfs:label "sourceSha256"@zh .

<urn:lzo:drawing-ontology:sourceText> a owl:DatatypeProperty ;
    rdfs:label "sourceText"@zh .

<urn:lzo:drawing-ontology:statementCategory> a owl:DatatypeProperty ;
    rdfs:label "statementCategory"@zh .

<urn:lzo:drawing-ontology:unitText> a owl:DatatypeProperty ;
    rdfs:label "unitText"@zh .

<urn:lzo:drawing-ontology:valueText> a owl:DatatypeProperty ;
    rdfs:label "valueText"@zh .

ns3:DemoAssignment a owl:Class ;
    rdfs:label "显式演示分配"@zh .

ns3:demoAssignedTo a owl:ObjectProperty ;
    rdfs:label "均分演示记录分配到"@zh ;
    owl:inverseOf ns3:hasDemoRecord ;
    ns3:assignmentPolicy "balanced_demo_only" ;
    ns3:synthetic true .

ns3:demoProfileFrom a owl:ObjectProperty ;
    rdfs:label "演示水深体积模板来自"@zh ;
    owl:inverseOf ns3:isDemoProfileFor ;
    ns3:assignmentPolicy "balanced_demo_only" ;
    ns3:synthetic true .

