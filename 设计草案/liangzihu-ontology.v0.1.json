{
  "schemaVersion": "lzh.ontology-design/0.1",
  "status": "design_draft_not_deployed",
  "title": "梁子湖农业业务本体与多源数据接入设计",
  "basis": {
    "originalDocument": "智慧农业本体论数据库架构与多模态数据处理.docx",
    "repository": "https://github.com/8jdkds7nzz-hub/liangzihu-farm-platform",
    "snapshotDate": "2026-10-04",
    "snapshotGitTree": "9995fc20cd84093adcaa3fab954ffe9d08b9f45a",
    "latestRemoteVerified": false,
    "note": "依据本地选取源码快照和 README；未运行数据库、未验证现场数据；拟新增项不是现有接口。"
  },
  "layers": [
    {
      "id": "semantic",
      "name": "语义与行为定义层",
      "owns": [
        "对象类型和属性契约",
        "链接类型与时态约束",
        "动作输入与服务绑定",
        "对象集查询定义",
        "标准映射和版本"
      ]
    },
    {
      "id": "facts",
      "name": "业务事实与证据层",
      "owns": [
        "现有业务表和服务",
        "私有原始资产",
        "运行和证据版本",
        "新增跨域关系断言"
      ]
    },
    {
      "id": "graph",
      "name": "可重建知识图与查询层",
      "owns": [
        "节点与关系投影",
        "对象导航和时间线",
        "数据血缘和物料溯源",
        "授权内语义查询"
      ]
    }
  ],
  "coreConcepts": {
    "Object": "对象类型是定义，具体对象是实例；业务表名 objects 只包含空间管理对象",
    "Property": "属性是类型约束；高频变化数值作为独立观测记录",
    "PrimaryKey": "复用原业务 UUID；跨类型引用为 {type,id}，外部身份另映射",
    "LinkType": "定义起终点类型、方向、基数、有效期、证据要求、反向关系",
    "ActionType": "参数契约加既有业务服务，不直接修改图或下发设备控制",
    "ObjectSet": "动态查询定义或固定成员快照，不能创建一套重复对象",
    "Lineage": "分开表达信息派生、实物转化和责任；记录输入、运行、输出和版本"
  },
  "extensions": [
    "Event/Activity 与 ActionType 分离",
    "Observation/Assertion 与属性分离",
    "Evidence/Asset 与结论分离",
    "Constraint/Policy 包含时空、版本、质量、授权和审批要求"
  ],
