  "propertyDefinitions": [
    {
      "id": "displayName",
      "dataType": "string",
      "semantics": "显示名，不作为对象身份"
    },
    {
      "id": "businessCode",
      "dataType": "string",
      "semantics": "业务可读编码，保留现有唯一性作用域"
    },
    {
      "id": "status",
      "dataType": "enum",
      "semantics": "每种类型单独定义允许值及状态转换"
    },
    {
      "id": "geometryRef",
      "dataType": "objectRef",
      "semantics": "版本化边界/几何引用，附坐标系、核实状态及有效期"
    },
    {
      "id": "sourceRef",
      "dataType": "sourceRef",
      "semantics": "可信系统内定位，不接受客户端任意表名或文件路径"
    },
    {
      "id": "validTime",
      "dataType": "interval",
      "semantics": "业务有效时间，与入库时间区分"
    },
    {
      "id": "revision",
      "dataType": "string",
      "semantics": "记录版本或内容哈希，保留既有 supersedes_id 关系"
    },
    {
      "id": "propertyId",
      "dataType": "termId",
      "semantics": "指标/可观测属性标识；术语映射与数值转换分开"
    },
    {
      "id": "unit",
      "dataType": "unitId",
      "semantics": "带量纲校验的单位；本地编码可映射 QUDT"
    },
    {
      "id": "quality",
      "dataType": "qualityRecord",
      "semantics": "完整率、测量不确定度、模型分数、复核状态分别存储"
    }
  ],
