{
  "package_id": "lzhu.protection",
  "version": "0.1.0",
  "namespace": "urn:lzhu:protection:",
  "label": "植保与处方",
  "description": "植保方案、处方、实际作业、交付及回访。 固定源提交 9995fc20cd84093adcaa3fab954ffe9d08b9f45a。此包定义来源系统记录类；不是已经完成农业业务概念等价对齐的目标本体。",
  "types": [
    {
      "type_id": "lzhu:protection_plans",
      "identity_type": "lzhu:protection_plans",
      "label": "植保作业方案",
      "description": "定义作物、目标、边界、敏感区、投入品和作业条件。 来源表 protection_plans；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:prescription_maps",
      "identity_type": "lzhu:prescription_maps",
      "label": "植保处方图",
      "description": "保存植保分区和剂量方案及版本，区别于执行记录。 来源表 prescription_maps；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:protection_executions",
      "identity_type": "lzhu:protection_executions",
      "label": "植保作业记录",
      "description": "记录实际作业时段、轨迹、用量、覆盖及补救关联。 来源表 protection_executions；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:prescription_events",
      "identity_type": "lzhu:prescription_events",
      "label": "处方使用事件",
      "description": "区分分享、下载和应用，应用可关联具体作业。 来源表 prescription_events；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:protection_deliveries",
      "identity_type": "lzhu:protection_deliveries",
      "label": "植保资料交付",
      "description": "记录服务方交付资产、缺项、接收人和交付依据。 来源表 protection_deliveries；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:protection_followups",
      "identity_type": "lzhu:protection_followups",
      "label": "植保作业回访",
