{
  "package_id": "lzhu.governance",
  "version": "0.1.0",
  "namespace": "urn:lzhu:governance:",
  "label": "治理与平台支撑",
  "description": "设备控制治理、管理报告、身份授权及平台技术支撑；分类分别保留。 固定源提交 9995fc20cd84093adcaa3fab954ffe9d08b9f45a。此包定义来源系统记录类；不是已经完成农业业务概念等价对齐的目标本体。",
  "types": [
    {
      "type_id": "lzhu:control_profiles",
      "identity_type": "lzhu:control_profiles",
      "label": "设备控制条件",
      "description": "描述设备可控性、模式、保护及断电行为，不是用户权限。 来源表 control_profiles；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:control_rules",
      "identity_type": "lzhu:control_rules",
      "label": "设备控制规则",
      "description": "保存按用途、物种和阶段定义的条件及审核版本。 来源表 control_rules；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:control_requests",
      "identity_type": "lzhu:control_requests",
      "label": "控制预检请求",
      "description": "仅保存被阻断且未派发的请求与原因，不能称已执行指令。 来源表 control_requests；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:control_feedback",
      "identity_type": "lzhu:control_feedback",
      "label": "控制分层反馈",
      "description": "区分请求、设备接收、电气、机械和效果层的观察证据。 来源表 control_feedback；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:control_takeovers",
      "identity_type": "lzhu:control_takeovers",
      "label": "人工接管记录",
      "description": "保存现场人员接管设备时的条件、时刻和依据。 来源表 control_takeovers；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:management_reports",
      "identity_type": "lzhu:management_reports",
      "label": "管理报告快照",
      "description": "保存生成任务及完成后的不可变输入与结果快照。 来源表 management_reports；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    }
  ],
