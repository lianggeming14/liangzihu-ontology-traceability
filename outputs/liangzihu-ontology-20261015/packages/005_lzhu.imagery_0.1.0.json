    },
    {
      "type_id": "lzhu:flight_annotations",
      "identity_type": "lzhu:flight_annotations",
      "label": "航次标注",
      "description": "围绕航次资料登记的人工或外部标注及其来源。 来源表 flight_annotations；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
