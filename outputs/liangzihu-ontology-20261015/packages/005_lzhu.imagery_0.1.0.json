{
  "package_id": "lzhu.imagery",
  "version": "0.1.0",
  "namespace": "urn:lzhu:imagery:",
  "label": "媒体与无人机",
  "description": "媒体原件、摄像头事件、航次、覆盖与栅格资料。 固定源提交 9995fc20cd84093adcaa3fab954ffe9d08b9f45a。此包定义来源系统记录类；不是已经完成农业业务概念等价对齐的目标本体。",
  "types": [
    {
      "type_id": "lzhu:media_assets",
      "identity_type": "lzhu:media_assets",
      "label": "媒体原件资产",
