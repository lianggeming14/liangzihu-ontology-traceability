{
  "package_id": "lzhu.knowledge",
  "version": "0.1.0",
  "namespace": "urn:lzhu:knowledge:",
  "label": "知识与简报",
  "description": "知识文档、简报内容、审核和发布快照。 固定源提交 9995fc20cd84093adcaa3fab954ffe9d08b9f45a。此包定义来源系统记录类；不是已经完成农业业务概念等价对齐的目标本体。",
  "types": [
    {
      "type_id": "lzhu:knowledge_documents",
      "identity_type": "lzhu:knowledge_documents",
      "label": "知识文档",
      "description": "知识材料的文档身份、版本及来源范围，不把文档内容自动当作现场事实。 来源表 knowledge_documents；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:briefings",
      "identity_type": "lzhu:briefings",
      "label": "农业简报",
      "description": "按周期生成并待审核的农业简报文档。 来源表 briefings；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:briefing_items",
      "identity_type": "lzhu:briefing_items",
      "label": "简报条目",
      "description": "简报中的事实引用、原始陈述与审核结果，保留来源和限制。 来源表 briefing_items；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:briefing_reviews",
      "identity_type": "lzhu:briefing_reviews",
      "label": "简报条目审核",
      "description": "对简报条目采纳、修改或拒绝的人工审核记录。 来源表 briefing_reviews；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    },
    {
      "type_id": "lzhu:briefing_publications",
      "identity_type": "lzhu:briefing_publications",
      "label": "简报发布快照",
      "description": "针对收件人和角色确认发布的简报快照，不等同公开发布。 来源表 briefing_publications；来源记录具有独立身份，源主键通过外部身份映射关联本库主键。"
    }
