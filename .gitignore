# 本机身份、凭据、运行状态和依赖不进入云端仓库
/%SystemDrive%/
/.github-upload/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
**/.deps/
**/.venv/
**/node_modules/
**/.kimi-runtime/
**/.kimi-skills/
**/.env
**/.env.*
!**/.env.example
**/api-tokens.json
**/*credentials*.json
**/*secret*.json
**/pg-local-password.txt
*.pem
*.key
/implementation/data/
/implementation/runtime/pg-data/
/implementation/runtime/postgresql/
/implementation/runtime/*.db*
/implementation/tests/browser/agri-ui-*/
/implementation/kimi-*.log
/implementation/kimi-*.jsonl
**/*-wal
**/*-shm
**/*.pending*

# 公开上游源码的临时分析副本；交付仅含派生目录和来源摘要
/implementation/runtime/ontology-source/

# 私有平台导出、批次计划及接收回执，禁止同步到公开仓库
/implementation/runtime/source-imports/

# 渲染库自动逐单元格调试缓存（正式检查报告另存）
/outputs/**/*.xlsx.inspect.ndjson
