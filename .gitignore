/.github-upload/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
**/.deps/
**/.venv/
**/node_modules/
**/.kimi-runtime/
**/.kimi-skills/
**/.env
**/.env.*
!**/.env.example
**/api-tokens.json
**/*credentials*.json
**/*secret*.json
**/pg-local-password.txt
*.pem
*.key
/implementation/data/
