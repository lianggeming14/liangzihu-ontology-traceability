            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "package_id",
          "version",
          "property_id"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "subject_key",
      "predicate_id",
      "evidence_ids"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "value"
        ],
        "not": {
          "required": [
            "object_key"
          ]
        }
      },
      {
        "required": [
          "object_key"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    ]
